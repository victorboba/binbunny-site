{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    { "source": "/.well-known/apple-app-site-association", "headers": [ { "key": "Content-Type", "value": "application/json" } ] },
    { "source": "/(.*)", "headers": [ { "key": "X-Content-Type-Options", "value": "nosniff" } ] }
  ],
  "rewrites": [
    { "source": "/l/:id", "destination": "/l/index.html" }
  ]
}
